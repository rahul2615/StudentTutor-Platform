# ── Application Secret Key & Database ─────────────────────
SECRET_KEY=dev-only-insecure-key-change-in-production
DATABASE_URI=sqlite:///site.db

# ── AI / Gemini Integration ────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Stripe Monetization (Test/Sandbox Mode) ───────────────
# Get test API keys from Stripe Dashboard -> Developers -> API keys: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Webhook Secret: Get by running `stripe listen --forward-to localhost:5000/payment/webhook` via Stripe CLI
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Subscription Plan Price IDs (Create products in Stripe Dashboard -> Products -> Pricing)
STRIPE_MONTHLY_PRICE_ID=price_monthly_test_id
STRIPE_YEARLY_PRICE_ID=price_yearly_test_id

# Platform fee percentage taken from tutor course sales (e.g., 15 = 15%)
PLATFORM_FEE_PERCENT=15
